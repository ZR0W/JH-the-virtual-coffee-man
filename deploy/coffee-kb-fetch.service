# coffee-kb daily collection job: systemd USER unit (agreed at checkpoint D).
#
# Install into ~/.config/systemd/user/ with the placeholders filled in (README, "Home server"):
#   @REPO_DIR@  absolute path of the coffee-kb checkout
#   @UV@        absolute path of the uv binary (`command -v uv`, usually ~/.local/bin/uv)
# and run `sudo loginctl enable-linger $USER` once so it runs without an open login session.
#
# Order of a run:
#   0. upgrade yt-dlp (an outdated extractor is the most common cause of failures). A failed
#      upgrade (e.g. PyPI unreachable) does not stop the run ("-" prefix).
#   1. discover  - self-throttles to once a week; failure ignored ("-") because fetch re-checks
#                  the cooldown latch itself before any request.
#   2. fetch     - --wait-for-cap: if the rolling 24 h cap is still full from yesterday's run,
#                  waits (up to max_wait_for_cap_minutes) for slots instead of exiting. Exits 75
#                  on a block signal or while data/COOLDOWN exists; the unit then shows as failed
#                  and nothing is retried (Restart=no).
#   3. normalize + dashboard - offline; run even when fetch failed (ExecStopPost).

[Unit]
Description=coffee-kb daily collection (discover weekly, capped fetch, normalize)

[Service]
Type=oneshot
WorkingDirectory=@REPO_DIR@
Nice=10
IOSchedulingClass=idle
# Up to 3 h waiting for cap slots + ~60-75 min for 30 videos; generous headroom.
TimeoutStartSec=6h
Restart=no
ExecStartPre=-@UV@ lock --upgrade-package yt-dlp
ExecStartPre=-@UV@ sync
ExecStart=-@UV@ run coffee-kb discover
ExecStart=@UV@ run coffee-kb fetch --wait-for-cap
ExecStopPost=@UV@ run coffee-kb normalize
ExecStopPost=@UV@ run coffee-kb dashboard
